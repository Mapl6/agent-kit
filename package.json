{
  "name": "agent-kit-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Local-first agent enhancement framework (monorepo)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @mapl6/agent-kit-core && npm run build -w @mapl6/agent-kit",
    "typecheck": "npm run typecheck -w @mapl6/agent-kit-core && npm run typecheck -w @mapl6/agent-kit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "format": "prettier --write \"packages/**/*.{ts,json,md}\" \"*.md\"",
    "agent-kit": "node packages/cli/dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}

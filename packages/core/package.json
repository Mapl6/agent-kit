{
  "name": "@mapl6/agent-kit-core",
  "version": "3.0.0",
  "description": "Core library for Agent Kit: safe repository discovery, detectors, and the project model.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/copy-package-docs.mjs core"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Mapl6 <mahdi.am6@gmail.com>",
  "keywords": [
    "ai-agents",
    "repository-scanner",
    "project-intelligence",
    "agent-kit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mapl6/agent-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Mapl6/agent-kit/issues"
  },
  "homepage": "https://github.com/Mapl6/agent-kit#readme"
}
